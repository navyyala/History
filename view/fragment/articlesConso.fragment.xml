<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:cust="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" xmlns="sap.m">
	<l:VerticalLayout class="sapUiResponsivePadding">
		<Table id="tableItems" noDataText="{18n>textFragmentTableNoPoste}" items="{/GOODS_ISSUESet}" updateFinished="onItemsLoaded">
			<headerToolbar>
				<Toolbar>
					<Title text="{i18n>textFragmentTableTitle} ()"/>
				</Toolbar>
			</headerToolbar>
			<columns>
				<Column id="colArticleNo" width="15%">
					<header>
						<Label id="lblArticleNo" text="{i18n>textFragmentLblArticleNumber}"/>
					</header>
				</Column>
				<Column id="colDescription" width="30%">
					<header>
						<Label id="lblDescription" text="{i18n>textFragmentLblDescription}"/>
					</header>
				</Column>
				<Column id="colQuantite" width="30%">
					<header>
						<Label id="lblQuantite" text="{i18n>textFragmentLblQuantity}"/>
					</header>
				</Column>
				<Column id="colUnite" width="25%">
					<header>
						<Label id="lblUnite" text="{i18n>textFragmentLblUnity}"/>
					</header>
				</Column>
					<!--JII 6585 -->
				<Column id="colStorageLoc" width="30%"> 
					<header>					
						<Label id="lblStorageLoc" text="{i18n>libColStorageLoc}"/>
					</header>
				</Column>
				<Column id="colStorageBin" width="30%"> 
					<header>					
						<Label id="lblStorageBin" text="{i18n>libColStorageBin}"/>
					</header>
				</Column>
					<Column  id="colDelete" width="10%">
					<header>
						<Label id="lblDelete" text=" "/>
					</header>
				</Column>
				<!--JII 6585 end-->
			</columns>
			<items>
				<ColumnListItem id="articleTemplate">
					<cells>
						<Text id="txtArticleNo" text="{path: 'Matnr', formatter: '.removeLeadingZeros'}"/>
						<Text id="txtDescription" text="{Maktx}"/>
						<Text id="txtQuantite" text="{Quantity}"/>
						<Text id="txtUnite" text="{Meins}"/>
						<!--JII 6585 -->
						<Text id="txtStorageLoc" text="{Lgort}"/> 
						<Text id="txtStorageBin" text="{Lgpbe}"/> 
						<Button icon="sap-icon://delete"  press=".stockOutputHelper.onDeleteStockOutput"/>
						<!--JII 6585 end-->
					</cells>
				</ColumnListItem>
			</items>
		</Table>
	</l:VerticalLayout>
</core:FragmentDefinition>
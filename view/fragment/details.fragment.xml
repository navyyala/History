<core:FragmentDefinition xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns="sap.m">
	<f:SimpleForm id="SimpleFormDisplay480"
				minWidth="1024"
				maxContainerCols="2"
				editable="false"
				layout="ResponsiveGridLayout"
				labelSpanL="4"
				labelSpanM="4"
				emptySpanL="0"
				emptySpanM="0"
				columnsL="2"
				columnsM="2"
				class="sapUiContentPadding">
				<f:content>
					<core:Title text="" class="sapUiTinyMargin"/>
					<Label text="{i18n>textFragmentLblPriority}"  class="sapUiTinyMargin"/>
					<Text text="{Priok} {Prioktxt}"  class="sapUiTinyMargin"/>
					<Label text="{i18n>textFragmentLblWorkType}" class="sapUiTinyMargin"/>
					<Text text="{Kurztext}" class="sapUiTinyMargin"/>
					<Label text="{i18n>textFragmentLblPlanNumber}" class="sapUiTinyMargin"/>
					<Text text="{path: 'Warpl', formatter: '.removeLeadingZeros'}" class="sapUiTinyMargin"/>
					<Label text="{i18n>textFragmentLblActivityType}" class="sapUiTinyMargin"/>
					<Text text="{Ilart}" class="sapUiTinyMargin"/>
					<core:Title text="" class="sapUiTinyMargin"/>
					<Label text="{i18n>textFragmentLblEmetteur}" class="sapUiTinyMargin"/>
					<Text text="{Qmnam}" class="sapUiTinyMargin"/>
					<Label text="{i18n>textFragmentLblIntervenant}" class="sapUiTinyMargin"/>
					<Text text="" class="sapUiTinyMargin"/>
				</f:content>
			</f:SimpleForm>
</core:FragmentDefinition>
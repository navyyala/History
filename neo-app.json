{
  "welcomeFile": "index.html",
  "routes": [
    {
      "path": "/destinations/ARC4C",
      "target": {
        "type": "destination",
        "name": "ARC4C"
      },
      "description": "AR - Cloud for Customer Demo"
    },
    {
      "path": "/resources",
      "target": {
        "type": "service",
        "name": "sapui5",
        "entryPath": "/resources",
        "version": "1.28.15"
      },
      "description": "SAPUI5 Resources"
    },
    {
      "path": "/test-resources",
      "target": {
        "type": "service",
        "name": "sapui5",
        "entryPath": "/test-resources",
        "version": "1.28.15"
      },
      "description": "SAPUI5 Test Resources"
    },
    {
      "path": "/sap/opu/odata",
      "target": {
        "type": "destination",
        "name": "GWD",
        "entryPath": "/sap/opu/odata"
      },
      "description": "GWD"
    },
    {
      "path": "/sap/bc/ui5_ui5",
      "target": {
        "type": "destination",
        "name": "GWD",
        "entryPath": "/sap/bc/ui5_ui5"
      },
      "description": "GWD"
    }
  ],
  "cacheControl": [
    {
      "directive": "private",

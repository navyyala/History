{
  "_version": "1.58.0",
  "sap.app": {
    "id": "PO_HISTORY",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.1.0"
    },
    "ach": "PM",
    "resources": "resources.json",
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZGPM_ORDER_HISTORY_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "model/metadata.xml",
          "annotations": []
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://approvals"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    },
    "supportedThemes": [
      "sap_fiori_3",
      "sap_fiori_3_dark",
      "sap_high_contrast_black",
      "sap_high_contrast_white"
    ]
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "PO_HISTORY.view.Main",
      "type": "XML",
      "async": false
    },
    "dependencies": {
      "minUI5Version": "1.71.0",
      "libs": {
        "sap.m": {},
        "sap.ui.layout": {},
        "sap.ui.core": {},
        "sap.ushell": {
          "lazy": true
        },
        "sap.ndc": {
          "lazy": true
        },
        "sap.ca.ui": {
          "lazy": true
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "handleValidation": true,
    "models": {
      "": {
        "dataSource": "mainService",
        "type": "sap.ui.model.odata.ODataModel",
        "preload": true,
        "settings": {
          "json": true,
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "orderitem": {
        "dataSource": "mainService",
        "type": "sap.ui.model.odata.v2.ODataModel"
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "PO_HISTORY.i18n.messageBundle",
          "supportedLocales": ["", "en", "de", "fr", "es", "pt"],
          "fallbackLocale": ""
        }
      }
    },
    "routing": {
      "config": {
        "viewType": "XML",
        "viewPath": "PO_HISTORY.view",
        "targetControl": "fioriContent",
        "targetAggregation": "pages",
        "clearTarget": false
      },
      "routes": [
        {
          "pattern": "",
          "name": "main",
          "view": "Master"
        },
        {
          "name": "details",
          "view": "Details",
          "pattern": "{entity}"
        }
      ]
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
